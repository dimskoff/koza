# koza — environment configuration
# cp .env.example .env   (never commit .env)

# ── domains ────────────────────────────────────────────────────────────
# Main host (short links) and box host (file transfer). Everything else —
# public URLs, CORS, TURN URLs, links in the UI — is derived from these.
KOZA_HOST=koza.example.com
KOZA_BOX_HOST=box.koza.example.com
# Optional overrides (default: https://<host>; http:// for localhost)
# KOZA_BASE_URL=https://koza.example.com
# KOZA_BOX_URL=https://box.koza.example.com

# ── security ───────────────────────────────────────────────────────────
# Required for admin endpoints (list/delete links and rooms).
# Empty = admin endpoints are disabled. Generate: openssl rand -hex 24
KOZA_ADMIN_KEY=

# Reverse proxies in front of the api that append X-Forwarded-For
# (Traefik / Caddy = 1). 0 = ignore the header (api exposed directly).
KOZA_TRUST_PROXY=1

# Extra browser origins allowed to call the API cross-origin (comma list).
# Default: KOZA_BASE_URL and KOZA_BOX_URL.
# KOZA_CORS_ORIGINS=

# ── anti-abuse ─────────────────────────────────────────────────────────
# Domains that may not be shortened (subdomains included), comma list.
# A file /data/blocklist.txt (one domain per line) is also read, live.
# KOZA_BLOCKED_DOMAINS=bad.example,phish.example
# Optional Google Safe Browsing v4 API key for destination checks.
# KOZA_SAFE_BROWSING_KEY=

# ── box / TURN ─────────────────────────────────────────────────────────
# Room lifetime in ms (default 1 hour)
KOZA_ROOM_TTL_MS=3600000
# coturn shared secret (use-auth-secret). Generate: openssl rand -hex 24
KOZA_TURN_SECRET=
# Default: turn:<KOZA_HOST>:3478 over udp + tcp
# KOZA_TURN_URLS=

# ── misc ───────────────────────────────────────────────────────────────
# Host ports for the plain docker-compose stack
KOZA_WEB_PORT=3000
KOZA_API_PORT=8787
# Explicit signaling URL if /signal is not served on the same host
# KOZA_SIGNAL_URL=wss://koza.example.com/signal
# Footer source link (MPL-2.0: keep it pointing at your fork's source)
# KOZA_REPO_URL=https://github.com/dimskoff/koza
