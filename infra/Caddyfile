# koza · automatic HTTPS reverse proxy (Caddy 2)
#
# 1. point the DNS A records of KOZA_HOST and KOZA_BOX_HOST at this server
# 2. set them in .env
# 3. docker compose --profile proxy up -d --build

{$KOZA_HOST}, {$KOZA_BOX_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# WebSocket signaling and long-lived relay streams go straight to the api
	@api path /signal /api/v1/box/stream/*
	handle @api {
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}

	# everything else (pages, /api/v1 proxy, short-link redirects) → Next.js
	handle {
		reverse_proxy web:3000
	}
}
