# ─────────────────────────────────────────────────────────────────────
# koza · automatic https reverse proxy (Caddy 2)
#
# 1. point your domains' A records at this box
# 2. set KOZA_HOST and KOZA_BOX_HOST in .env
# 3. docker compose --profile proxy up -d
# ─────────────────────────────────────────────────────────────────────

{$KOZA_HOST:koza.click}, {$KOZA_BOX_HOST:box.koza.click} {
	# websocket signaling — long-lived, no buffering
	handle /signal* {
		reverse_proxy api:8787
	}

	# the api
	handle /api/* {
		reverse_proxy api:8787
	}

	# next.js frontend + short link resolution
	handle {
		reverse_proxy web:3000
	}

	encode gzip
}
